APP_ENV=local
APP_DEBUG=0

# Generate a random value of at least 32 characters for every environment.
# Never commit the real value.
BUBBLE_ROYALE_SESSION_SECRET=replace-with-a-random-32-character-minimum-secret
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
RATE_LIMIT_PATH=storage/cache/rate-limits
COOKIE_SECURE=0
RUN_MIGRATIONS=0
MIGRATION_RETRIES=30
